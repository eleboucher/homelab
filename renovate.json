{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>home-operations/renovate-presets#8.1.0",
    "github>home-operations/renovate-presets//apps/grafanaDashboards.json5#8.1.0",
    "github>home-operations/renovate-presets//apps/searxng.json5#8.1.0",
    "github>home-operations/renovate-presets//apps/cnpg.json5#8.1.0",
    "github>home-operations/renovate-presets//apps/talosFactory.json5#8.1.0"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/\\.yaml(?:\\.j2)?$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>[^\\s]+)\\s+url: \"https://github\\.com/(?:[^/]+/[^/]+)/releases/download/(?<currentValue>[^/]+)/[^\"]+\""
      ],
      "datasourceTemplate": "{{datasource}}",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "Talos group",
      "groupName": "Talos",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/installer/", "/talosctl/"],
      "group": {
        "commitMessageTopic": "{{{groupName}}} group"
      },
      "minimumGroupSize": 2
    },
    {
      "description": "Towonel group",
      "groupName": "Towonel",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/towonel/"],
      "group": {
        "commitMessageTopic": "{{{groupName}}} group"
      },
      "minimumGroupSize": 2
    },
    {
      "description": "Auto merge container digests",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["digest"],
      "matchPackageNames": ["ghcr.io/home-operations/**", "ghcr.io/bjw-s-labs/**"],
      "automerge": true
    },
    {
      "description": "Auto-merge trusted OCI digests",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["digest"],
      "matchPackagePrefixes": ["ghcr.io/home-operations", "ghcr.io/bjw-s", "ghcr.io/bjw-s-labs"],
      "automerge": true,
      "automergeType": "pr",
      "ignoreTests": false
    },
    {
      "description": "Auto-merge high-cadence OCI packages weekly",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["ghcr.io/renovatebot/renovate", "/kube-prometheus-stack/"],
      "automerge": true,
      "automergeType": "pr",
      "ignoreTests": false,
      "schedule": ["before 6am on Monday"]
    },
    {
      "description": "Auto-merge Grafana dashboards",
      "matchDatasources": ["custom.grafana-dashboards"],
      "matchUpdateTypes": ["major"],
      "automerge": true,
      "automergeType": "branch",
      "ignoreTests": true
    },
    {
      "description": "Auto-merge Renovate Presets",
      "matchManagers": ["renovate-config"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "branch",
      "ignoreTests": true
    },
    {
      "description": "Auto-merge Renovate Presents",
      "matchManagers": ["renovate-config"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "branch",
      "ignoreTests": true
    },
    {
      "description": "Auto-merge high-cadence packages weekly",
      "matchDatasources": ["docker"],
      "automerge": true,
      "matchUpdateTypes": ["digest", "minor", "patch"],
      "matchPackageNames": [
        "ghcr.io/renovatebot/renovate",
        "ghcr.io/cloudnative-pg/postgis-extension-testing",
        "ghcr.io/cloudnative-pg/postgresql",
        "ghcr.io/emberstack/helm-charts/reflector",
        "ghcr.io/mogenius/helm-charts/renovate-operator"
      ],
      "schedule": ["before 6am on Monday"]
    },
    {
      "description": "Flux Operator Group",
      "groupName": "flux-operator",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/flux-operator/", "/flux-instance/"],
      "group": {
        "commitMessageTopic": "{{{groupName}}} group"
      },
      "minimumGroupSize": 2
    },
    {
      "description": "Intel Device Plugins Group",
      "groupName": "intel-device-plugins",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/intel-device-plugins-operator/", "/intel-device-plugins-gpu/"],
      "group": {
        "commitMessageTopic": "{{{groupName}}} group"
      },
      "minimumGroupSize": 2
    },
    {
      "description": "sparkyfitness group",
      "groupName": "sparkyfitness",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/sparkyfitness/"],
      "group": {
        "commitMessageTopic": "{{{groupName}}} group"
      }
    },
    {
      "description": "1Password Connect group",
      "groupName": "1Password Connect",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/1password/"],
      "group": {
        "commitMessageTopic": "{{{groupName}}} group"
      },
      "minimumGroupSize": 2
    },
    {
      "description": "Kubernetes group",
      "groupName": "Kubernetes",
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "/kube-apiserver/",
        "/kube-controller-manager/",
        "/kube-proxy/",
        "/kube-scheduler/",
        "/kubelet/"
      ],
      "group": {
        "commitMessageTopic": "{{{groupName}}} group"
      },
      "minimumGroupSize": 5
    },
    {
      "description": "Toolhive group",
      "groupName": "Toolhive",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/toolhive-operator/"],
      "group": {
        "commitMessageTopic": "{{{groupName}}} group"
      },
      "minimumGroupSize": 2
    }
  ]
}
