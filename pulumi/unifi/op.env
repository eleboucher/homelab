# Loaded by `op run --env-file=op.env -- ...`. Values are 1Password references,
# safe to commit.

AWS_ACCESS_KEY_ID=op://kubernetes/ovh-tofu-state/AWS_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=op://kubernetes/ovh-tofu-state/AWS_SECRET_ACCESS_KEY
PULUMI_CONFIG_PASSPHRASE=op://kubernetes/pulumi/passphrase

UNIFI_API=https://192.168.1.1
UNIFI_INSECURE=true
UNIFI_API_KEY=op://kubernetes/unifi-tofu/api_key

WIFI_SSID=op://kubernetes/wifi/ssid
WIFI_PASSPHRASE=op://kubernetes/wifi/password
WIFI_IOT_PASSWORD=op://kubernetes/wifi/iot_password

AIRVPN_WG_CONF=op://kubernetes/airvpn/wireguard_conf
AIRVPN_WG_ADDRESS=op://kubernetes/airvpn/wireguard_address
AIRVPN_PORT=op://kubernetes/airvpn/port

BLOCKY_DOH_STAMP=op://towonel-prod/blocky/DOH_STAMP
