ROS_HOSTURL=https://192.168.1.2
ROS_INSECURE=true
ROS_USERNAME=op://kubernetes/mkt-admin/username
ROS_PASSWORD=op://kubernetes/mkt-admin/password

USER_PASSWORD_MKTXP_USER=op://kubernetes/mikrotik-export/password
USER_PASSWORD_HOME_ASSISTANT=op://kubernetes/mkt-home-assistant/password
