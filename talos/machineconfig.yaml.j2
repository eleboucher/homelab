---
version: v1alpha1
machine:
  ca:
    crt: ref+op://kubernetes/talos/MACHINE_CA_CRT
    {% if ENV.CONTROLPLANE %}
    key: ref+op://kubernetes/talos/MACHINE_CA_KEY
    {% endif %}
  features:
    apidCheckExtKeyUsage: true
    diskQuotaSupport: true
    hostDNS:
      enabled: true
      forwardKubeDNSToHost: true # Requires Cilium socketLB features
      resolveMemberNames: true
    kubePrism:
      enabled: true
      port: 7445
    {% if ENV.CONTROLPLANE %}
    kubernetesTalosAPIAccess:
      allowedKubernetesNamespaces:
        - actions-runner-system
        - system-upgrade
        - ai
      allowedRoles:
        - os:admin
        - os:reader
      enabled: true
    {% endif %}
    rbac: true
  install:
    grubUseUKICmdline: true
    image: factory.talos.dev/metal-installer/{{ ENV.SCHEMATIC }}:v1.14.0-rc.2
    wipe: false
  kernel:
    modules:
      - name: binfmt_misc # qemu-user registration for multi-arch buildx
      - name: dm_thin_pool # homefs lvmthin backend
      - name: drbd # homefs replication
        parameters:
          - usermode_helper=disabled # required on Talos (no usermodehelper)
      - name: drbd_transport_tcp
      - name: nbd
      - name: nfsd
      - name: zfs
  kubelet:
    defaultRuntimeSeccompProfileEnabled: true
    disableManifestsDirectory: true
    extraMounts:
      # openebs-hostpath basePath — /var/mnt is read-only for kubelet unless bind-mounted
      - destination: /var/mnt/local-hostpath
        type: bind
        source: /var/mnt/local-hostpath
        options:
          - bind
          - rshared
          - rw
    extraConfig:
      # Let the Miroir agent detach DRBD backings after workloads stop.
      shutdownGracePeriod: 120s
      shutdownGracePeriodCriticalPods: 60s
      imageGCHighThresholdPercent: 70
      imageGCLowThresholdPercent: 50
      maxPods: 250
      serializeImagePulls: false
    image: ghcr.io/siderolabs/kubelet:v1.37.0
    nodeIP:
      validSubnets:
        - 192.168.1.0/24
        - 2a01:e0a:e4b:aa31::/64
  nodeLabels:
    node.kubernetes.io/gpu: "true"
    intel.feature.node.kubernetes.io/gpu: "true"
    topology.kubernetes.io/region: main
  sysctls:
    fs.inotify.max_user_instances: "8192"
    fs.inotify.max_user_watches: "1048576"
    net.core.default_qdisc: fq
    net.core.rmem_max: "67108864"
    net.core.wmem_max: "67108864"
    net.ipv4.neigh.default.gc_thresh1: "4096"
    net.ipv4.neigh.default.gc_thresh2: "8192"
    net.ipv4.neigh.default.gc_thresh3: "16384"
    net.ipv6.neigh.default.gc_thresh1: "4096"
    net.ipv6.neigh.default.gc_thresh2: "8192"
    net.ipv6.neigh.default.gc_thresh3: "16384"
    net.ipv4.ping_group_range: 0 2147483647
    net.ipv4.tcp_congestion_control: bbr
    net.ipv4.tcp_fastopen: "3"
    net.ipv4.tcp_mtu_probing: "1"
    net.ipv4.tcp_notsent_lowat: "131072"
    net.ipv4.tcp_rmem: 4096 87380 33554432
    net.ipv4.tcp_slow_start_after_idle: "0"
    net.ipv4.tcp_window_scaling: "1"
    net.ipv4.tcp_wmem: 4096 65536 33554432
    net.ipv6.conf.all.forwarding: "1"
    net.ipv6.conf.bond0.accept_ra: "2"
    sunrpc.tcp_max_slot_table_entries: "128"
    sunrpc.tcp_slot_table_entries: "128"
    user.max_user_namespaces: "11255"
    vm.nr_hugepages: "1024"
  token: ref+op://kubernetes/talos/MACHINE_TOKEN
cluster:
  ca:
    crt: ref+op://kubernetes/talos/CLUSTER_CA_CRT
    {% if ENV.CONTROLPLANE %}
    key: ref+op://kubernetes/talos/CLUSTER_CA_KEY
    {% endif %}
  clusterName: homelab
  controlPlane:
    endpoint: https://k8s.internal:6443
  discovery:
    enabled: true
    registries:
      kubernetes: { disabled: true }
      service: { disabled: false }
  id: ref+op://kubernetes/talos/CLUSTER_ID
  network:
    cni:
      name: none
    dnsDomain: cluster.local
    podSubnets:
      - 10.42.0.0/16
      - fd42::/56
    serviceSubnets:
      - 10.43.0.0/16
      - fd43::/108
  secret: ref+op://kubernetes/talos/CLUSTER_SECRET
  token: ref+op://kubernetes/talos/CLUSTER_TOKEN
  {% if ENV.CONTROLPLANE %}
  aggregatorCA:
    crt: ref+op://kubernetes/talos/CLUSTER_AGGREGATORCA_CRT
    key: ref+op://kubernetes/talos/CLUSTER_AGGREGATORCA_KEY
  allowSchedulingOnControlPlanes: true
  apiServer:
    auditPolicy:
      apiVersion: audit.k8s.io/v1
      kind: Policy
      rules:
        - level: Metadata
    certSANs:
      - 127.0.0.1
      - 192.168.1.42
      - k8s.internal
    disablePodSecurityPolicy: true
    env:
      GOMEMLIMIT: 3GiB
    extraArgs:
      enable-aggregator-routing: "true"
      feature-gates: HPAScaleToZero=true
    image: registry.k8s.io/kube-apiserver:v1.37.0
  controllerManager:
    extraArgs:
      bind-address: 0.0.0.0
      feature-gates: HPAScaleToZero=true
      # Tolerate transient etcd fsync stalls without losing leadership (defaults 15s/10s/2s)
      leader-elect-lease-duration: 30s
      leader-elect-renew-deadline: 20s
      leader-elect-retry-period: 4s
    image: registry.k8s.io/kube-controller-manager:v1.37.0
  coreDNS:
    disabled: true
  etcd:
    advertisedSubnets:
      - 192.168.1.0/24
    ca:
      crt: ref+op://kubernetes/talos/CLUSTER_ETCD_CA_CRT
      key: ref+op://kubernetes/talos/CLUSTER_ETCD_CA_KEY
    extraArgs:
      auto-compaction-mode: revision
      auto-compaction-retention: "10000"
      listen-metrics-urls: http://0.0.0.0:2381
      snapshot-count: "5000"
      heartbeat-interval: "500"
      election-timeout: "5000"
  proxy:
    disabled: true
    image: registry.k8s.io/kube-proxy:v1.37.0
  scheduler:
    config:
      apiVersion: kubescheduler.config.k8s.io/v1
      kind: KubeSchedulerConfiguration
      # Tolerate transient etcd fsync stalls without losing leadership (defaults 15s/10s/2s)
      leaderElection:
        leaseDuration: 30s
        renewDeadline: 20s
        retryPeriod: 4s
      profiles:
        - schedulerName: default-scheduler
          plugins:
            score:
              disabled:
                - name: ImageLocality
          pluginConfig:
            - name: PodTopologySpread
              args:
                defaultingType: List
                defaultConstraints:
                  - maxSkew: 1
                    topologyKey: kubernetes.io/hostname
                    whenUnsatisfiable: ScheduleAnyway
    extraArgs:
      bind-address: 0.0.0.0
    image: registry.k8s.io/kube-scheduler:v1.37.0
  secretboxEncryptionSecret: ref+op://kubernetes/talos/CLUSTER_SECRETBOXENCRYPTIONSECRET
  serviceAccount:
    key: ref+op://kubernetes/talos/CLUSTER_SERVICEACCOUNT_KEY
  {% endif %}
{% if ENV.NODE %}
---
apiVersion: v1alpha1
kind: HostnameConfig
auto: "off"
hostname: {{ ENV.NODE }}
{% endif %}
---
apiVersion: v1alpha1
kind: BridgeConfig
name: bond0
mtu: 9000
links:
  - lacp0
stp:
  enabled: false
# On-link route to the Freebox client prefix so nodes can return LB v6 traffic.
routes:
  - destination: 2a01:e0a:e4b:aa30::/64
    gateway: 2a01:e0a:e4b:aa31::1
  # aa31::/64 is delegated to the Mikrotik, so egress from it has to leave the
  # same way or its stateful forward chain drops the replies. Metric beats the
  # RA default via the Freebox.
  - gateway: 2a01:e0a:e4b:aa31::1
    metric: 100
---
apiVersion: v1alpha1
kind: DHCPv4Config
name: bond0
clientIdentifier: mac
---
apiVersion: v1alpha1
kind: EtcFileConfig
name: nfsmount.conf
mode: 0o644
contents: |
  [ NFSMount_Global_Options ]
  nfsvers=4.2
  soft=True
  timeo=50
  retrans=3
  nconnect=8
  noatime=True
  rsize=1048576
  wsize=1048576
---
apiVersion: v1alpha1
kind: CRICustomizationConfig
name: containerd
content: |
  [plugins]
    [plugins."io.containerd.grpc.v1.cri"]
      enable_unprivileged_ports = true
      enable_unprivileged_icmp = true
  [plugins."io.containerd.cri.v1.images"]
    discard_unpacked_layers = false
  [plugins."io.containerd.cri.v1.runtime"]
    device_ownership_from_security_context = true
---
apiVersion: v1alpha1
kind: WatchdogTimerConfig
device: /dev/watchdog0
timeout: 5m
---
apiVersion: v1alpha1
kind: ResolverConfig
nameservers:
  - address: 192.168.1.2
  - address: 2a01:e0a:e4b:aa31::1
---
apiVersion: v1alpha1
kind: KmsgLogConfig
name: fluent-bit
url: tcp://127.0.0.1:5170/
